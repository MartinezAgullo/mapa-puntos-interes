    {
      "name": "10. PUT - Actualizar Punto",
      "request": {
        "method": "PUT",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"descripcion\": \"Descripción actualizada del punto de interés\",\n  \"telefono\": \"+34 912 345 678\",\n  \"website\": \"https://www.nuevo-sitio-web.com\"\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/puntos/1",
          "host": ["{{base_url}}"],
          "path": ["api", "puntos", "1"]
        },
        "description": "Actualiza un punto de interés existente. Solo actualiza los campos enviados."
      },
      "response": []
    },
    {
      "name": "11. DELETE - Eliminar Punto",
      "request": {
        "method": "DELETE",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/puntos/{{punto_id}}",
          "host": ["{{base_url}}"],
          "path": ["api", "puntos", "{{punto_id}}"]
        },
        "description": "Elimina un punto de interés. Usa la variable punto_id guardada."
      },
      "response": []
    },
    {
      "name": "12. GET - Categorías Disponibles",
      "request": {
        "method": "GET",
        "header": [],
