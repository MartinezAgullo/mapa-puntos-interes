{
  "info": {
    "name": "Puntos de Interés - España API",
    "description": "Colección completa de endpoints para gestionar puntos de interés en España usando PostGIS",
    "schema": "https://schema.getpostman.com/json/collection/v2.1.0/collection.json",
    "_exporter_id": "12345"
  },
  "variable": [
    {
      "key": "base_url",
      "value": "http://localhost:3000",
      "type": "string"
    },
    {
      "key": "punto_id",
      "value": "",
      "type": "string"
    }
  ],
  "item": [
    {
      "name": "1. GET - Todos los Puntos",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has success property\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "});",
              "",
              "pm.test(\"Response has data array\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data).to.be.an('array');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/puntos",
          "host": ["{{base_url}}"],
          "path": ["api", "puntos"]
        },
        "description": "Obtiene todos los puntos de interés almacenados en la base de datos"
      },
      "response": []
    },
    {
      "name": "2. GET - Punto por ID",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 200\", function () {",
              "    pm.response.to.have.status(200);",
              "});",
              "",
              "pm.test(\"Response has punto data\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.data).to.have.property('nombre');",
              "    pm.expect(jsonData.data).to.have.property('latitud');",
              "    pm.expect(jsonData.data).to.have.property('longitud');",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/puntos/1",
          "host": ["{{base_url}}"],
          "path": ["api", "puntos", "1"]
        },
        "description": "Obtiene un punto de interés específico por su ID"
      },
      "response": []
    },
    {
      "name": "3. GET - Puntos por Categoría",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/puntos/categoria/Museo",
          "host": ["{{base_url}}"],
          "path": ["api", "puntos", "categoria", "Museo"]
        },
        "description": "Filtra puntos de interés por categoría (Museo, Monumento, Playa, etc.)"
      },
      "response": []
    },
    {
      "name": "4. GET - Puntos Cercanos (Madrid 50km)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/puntos/cerca/-3.7038/40.4168?radio=50000",
          "host": ["{{base_url}}"],
          "path": ["api", "puntos", "cerca", "-3.7038", "40.4168"],
          "query": [
            {
              "key": "radio",
              "value": "50000",
              "description": "Radio en metros (50000 = 50km)"
            }
          ]
        },
        "description": "Busca puntos de interés dentro de un radio de 50km desde Madrid (Puerta del Sol)"
      },
      "response": []
    },
    {
      "name": "5. GET - Puntos Cercanos (Barcelona 100km)",
      "request": {
        "method": "GET",
        "header": [],
        "url": {
          "raw": "{{base_url}}/api/puntos/cerca/2.1686/41.3874?radio=100000",
          "host": ["{{base_url}}"],
          "path": ["api", "puntos", "cerca", "2.1686", "41.3874"],
          "query": [
            {
              "key": "radio",
              "value": "100000",
              "description": "Radio en metros (100000 = 100km)"
            }
          ]
        },
        "description": "Busca puntos de interés dentro de un radio de 100km desde Barcelona (Plaza Catalunya)"
      },
      "response": []
    },
    {
      "name": "6. POST - Crear Nuevo Punto",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Response has created data\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.success).to.be.true;",
              "    pm.expect(jsonData.data).to.have.property('id');",
              "});",
              "",
              "// Guardar el ID del punto creado",
              "var jsonData = pm.response.json();",
              "pm.environment.set(\"punto_id\", jsonData.data.id);"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Catedral de Sevilla\",\n  \"descripcion\": \"La catedral gótica más grande del mundo, declarada Patrimonio de la Humanidad por la UNESCO\",\n  \"categoria\": \"Catedral\",\n  \"direccion\": \"Av. de la Constitución, s/n\",\n  \"ciudad\": \"Sevilla\",\n  \"provincia\": \"Sevilla\",\n  \"codigo_postal\": \"41004\",\n  \"telefono\": \"+34 954 21 49 71\",\n  \"email\": \"info@catedralsevilla.es\",\n  \"website\": \"https://www.catedralsevilla.es\",\n  \"latitud\": 37.3860,\n  \"longitud\": -5.9930\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/puntos",
          "host": ["{{base_url}}"],
          "path": ["api", "puntos"]
        },
        "description": "Crea un nuevo punto de interés con todos los campos"
      },
      "response": []
    },
    {
      "name": "7. POST - Crear Punto Mínimo",
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
          "mode": "raw",
          "raw": "{\n  \"nombre\": \"Mi Lugar Favorito\",\n  \"categoria\": \"Otro\",\n  \"ciudad\": \"Madrid\",\n  \"provincia\": \"Madrid\",\n  \"latitud\": 40.4168,\n  \"longitud\": -3.7038\n}"
        },
        "url": {
          "raw": "{{base_url}}/api/puntos",
