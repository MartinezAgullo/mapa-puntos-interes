          "path": ["api", "puntos"]
        },
        "description": "Crea un punto de interés con solo los campos requeridos"
      },
      "response": []
    },
    {
      "name": "8. POST - Carga Masiva (Batch) - Monumentos",
      "event": [
        {
          "listen": "test",
          "script": {
            "exec": [
              "pm.test(\"Status code is 201\", function () {",
              "    pm.response.to.have.status(201);",
              "});",
              "",
              "pm.test(\"Multiple points created\", function () {",
              "    var jsonData = pm.response.json();",
              "    pm.expect(jsonData.count).to.be.above(0);",
              "});"
            ],
            "type": "text/javascript"
          }
        }
      ],
      "request": {
        "method": "POST",
        "header": [
          {
            "key": "Content-Type",
            "value": "application/json"
          }
        ],
        "body": {
